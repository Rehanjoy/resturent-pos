# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string. Local dev default points at a local mongod;
# for Atlas use the connection string from the cluster's "Connect" dialog.
MONGODB_URI=mongodb://127.0.0.1:27017/saffron

# Comma-separated list of allowed frontend origins (protocol + host + port,
# no trailing slash) so the browser allows credentialed requests (cookies)
# from the admin/POS app. Add every deployed frontend URL you need, e.g.
# CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# JWT signing secrets. Generate long random strings, e.g.:
#   openssl rand -hex 32
# Use a different value for each secret; never reuse between access/refresh
# and never commit real values.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Token lifetimes (jsonwebtoken duration strings, e.g. "15m", "7d").
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AES-256-GCM key protecting secrets-at-rest for the Marketing module (the
# Meta WhatsApp access token now; a Gemini API key in Part 3). Must be
# exactly 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse across environments; rotating it makes every previously
# encrypted secret unreadable, so treat it like a signing key.
ENCRYPTION_KEY=replace-with-a-64-character-hex-string
