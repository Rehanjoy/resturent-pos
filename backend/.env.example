# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string. Local dev default points at a local mongod;
# for Atlas use the connection string from the cluster's "Connect" dialog.
MONGODB_URI=mongodb://127.0.0.1:27017/saffron

# Must match the frontend's origin exactly (protocol + host + port) so the
# browser allows credentialed requests (cookies) from the admin/POS app.
CORS_ORIGIN=http://localhost:3000
